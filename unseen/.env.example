# UNSEEN — environment template. Copy to `.env` (gitignored) and fill in real values.
# Everything runs WITHOUT keys (deterministic AI fallback + bundled public-domain BSB);
# add keys to switch to the live partner APIs. Never commit real keys.

# ── Server ──────────────────────────────────────────────────────────────────
ENV=development                  # development | production (production disables /api/docs)
LOG_LEVEL=info
APP_BASE_URL=http://localhost:8000   # used to build public prayer links (/p/<token>)
STATIC_DIR=static                # where the built PWA is served from (Docker: /srv/static)
DEFAULT_BIBLE_ID=3034            # Berean Standard Bible (public domain)

# Redis is OPTIONAL for a single-process dev server (an in-memory store is used),
# but REQUIRED for the Docker image (2 uvicorn workers): rate limits and prayer
# tokens must be shared across workers. docker-compose sets this automatically.
REDIS_URL=

# PostgreSQL (asyncpg DSN). Durable server state: each install's own records
# (profile, battles, stones, allies, Armory, Watch — synced from the phone via
# /api/me), prayer links, anonymous installs, AI-call metadata and the Truth
# Index references (database/README.md). OPTIONAL: unset = everything stays on
# the phone, prayer links stay in Redis/memory and the Truth Index is bundled. docker-compose sets this.
# Local dev example (matches `docker run ... postgres:16` on port 5433):
# DATABASE_URL=postgresql://unseen:unseen@localhost:5433/unseen
DATABASE_URL=

# Cross-origin callers allowed to use /api. The browser PWA is same-origin and
# needs none; the native Android shell (Capacitor) serves the UI from its own
# origin and must be listed. Comma-separated.
CORS_ORIGINS=https://localhost,capacitor://localhost,http://localhost

# ── Gloo AI Studio (discernment · truth selection · compose · insight) ──────
# Either a direct API key OR OAuth2 client credentials. Unset = deterministic fallback.
GLOO_API_KEY=
GLOO_CLIENT_ID=
GLOO_CLIENT_SECRET=
GLOO_MODEL_FAST=gloo-anthropic-claude-haiku-4.5

# ── OpenAI (Whisper speech-to-text + read-aloud TTS) ────────────────────────
# Unset = voice features report "off" via /api/health and the app falls back to typing.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
MAX_AUDIO_SIZE_MB=25

# ── YouVersion Platform (authoritative Scripture) ───────────────────────────
# With a key: GET /api/bibles lists the English versions the key is licensed for
# (NIV, NASB, AMP, …), users pick one in onboarding/Settings, and every verse is
# fetched live and shown with that version's copyright notice.
# Unset = only the bundled public-domain BSB is offered; displayed verses are still verified.
YVP_APP_KEY=

# ── Frontend build-time (Vite; baked into the bundle, so NEVER put secrets here) ──
VITE_DEFAULT_BIBLE_ID=3034
# Native Android shell only: the WebView must be told where the API lives.
# Browser/PWA builds leave this empty (same-origin). Example for a LAN demo device:
# VITE_API_BASE=http://192.168.0.123:8000
VITE_API_BASE=
